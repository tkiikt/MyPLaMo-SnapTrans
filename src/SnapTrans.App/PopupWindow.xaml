<Window x:Class="SnapTrans.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" PointerPressed="Root_PointerPressed" PointerMoved="Root_PointerMoved" PointerReleased="Root_PointerReleased" PointerCaptureLost="Root_PointerCaptureLost" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Padding="22,14,10,4" ColumnSpacing="4" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PopupStatus" />
                <!-- Shown only when something needs attention (e.g. the GPU could not be used); details in the tooltip. -->
                <FontIcon x:Name="WarningIcon" Glyph="&#xE7BA;" FontSize="13" Foreground="#FFC857" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.AutomationId="PopupWarning" />
            </StackPanel>
            <Button x:Name="SourceButton" Grid.Column="2" Style="{StaticResource PopupIconButton}" Click="Source_Click" AutomationProperties.AutomationId="PopupSourceButton">
                <!-- Fixed "switch" glyph (U+E8AB). The header says what is shown; the tooltip says where the button goes. -->
                <FontIcon x:Name="SourceIcon" Glyph="&#xE8AB;" FontSize="16" />
            </Button>
            <Button x:Name="CopyButton" Grid.Column="3" Style="{StaticResource PopupIconButton}" Click="Copy_Click" AutomationProperties.AutomationId="PopupCopyButton">
                <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="16" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource PopupIconButton}" Click="Close_Click" AutomationProperties.AutomationId="PopupCloseButton">
                <FontIcon Glyph="&#xE8BB;" FontSize="12" />
            </Button>
        </Grid>
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Padding="22,4,22,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,0" />
                <TextBlock x:Name="BodyText" FontSize="17" LineHeight="30" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="PopupBodyText" />
                <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
